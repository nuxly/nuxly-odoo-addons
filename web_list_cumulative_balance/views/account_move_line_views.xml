<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <!-- account.view_move_line_tree is the base "Journal Items" list view (account module). -->
    <record id="view_move_line_tree_cumulative_balance" model="ir.ui.view">
        <field name="name">account.move.line.list.cumulative.balance</field>
        <field name="model">account.move.line</field>
        <field name="inherit_id" ref="account.view_move_line_tree"/>
        <field name="arch" type="xml">
            <field name="balance" position="after">
                <field name="x_cumulative_balance" widget="cumulative_balance" optional="show" readonly="1"/>
            </field>
        </field>
    </record>
</odoo>
