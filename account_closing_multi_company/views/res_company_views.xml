<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_company_list_closing_multi" model="ir.ui.view">
        <field name="name">res.company.list.closing.multi</field>
        <field name="model">res.company</field>
        <field name="arch" type="xml">
            <list create="0" delete="0">
                <field name="display_name" string="Company"/>
                <field name="sale_lock_date" string="Sales lock" readonly="1" width="140px"/>
                <field name="purchase_lock_date" string="Purchase lock" readonly="1" width="140px"/>
                <field name="tax_lock_date" string="Tax lock" readonly="1" width="140px"/>
                <field name="fiscalyear_lock_date" string="Lock everything" readonly="1" width="140px"/>
                <button name="action_open_closing_multi_wizard" type="object" string="Close" icon="fa-lock" width="120px"/>
            </list>
        </field>
    </record>

    <record id="action_account_closing_multi_company_list" model="ir.actions.act_window">
        <field name="name">Lock dates</field>
        <field name="res_model">res.company</field>
        <field name="view_mode">list</field>
        <field name="view_id" ref="view_company_list_closing_multi"/>
    </record>

    <record id="action_open_closing_multi_wizard_server" model="ir.actions.server">
        <field name="name">Close period</field>
        <field name="model_id" ref="base.model_res_company"/>
        <field name="binding_model_id" ref="base.model_res_company"/>
        <field name="binding_view_types">list</field>
        <field name="state">code</field>
        <field name="group_ids" eval="[(6, 0, [ref('account.group_account_user'), ref('account.group_account_manager')])]"/>
        <field name="code">action = records.action_open_closing_multi_wizard()</field>
    </record>

    <record id="menu_account_closing_multi_company_period" model="ir.ui.menu">
        <field name="name">Lock dates</field>
        <field name="parent_id" ref="account.account_closing_menu"/>
        <field name="action" ref="action_account_closing_multi_company_list"/>
        <!-- The "groups" shorthand on <menuitem> only ever ADDS groups across module upgrades, it never
             removes a group set by an earlier version - an explicit (6, 0, [...]) here is required to
             really replace the set. Both groups are listed explicitly: account.group_account_manager
             does NOT imply account.group_account_user in this Odoo version (verified), so listing the
             manager group alone would hide this menu from plain accounting users. -->
        <field name="group_ids" eval="[(6, 0, [ref('account.group_account_user'), ref('account.group_account_manager')])]"/>
        <field name="sequence">65</field>
    </record>

</odoo>
