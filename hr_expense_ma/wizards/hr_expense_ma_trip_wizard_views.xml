<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_hr_expense_ma_trip_wizard_form" model="ir.ui.view">
        <field name="name">hr.expense.ma.trip.wizard.form</field>
        <field name="model">hr.expense.ma.trip.wizard</field>
        <field name="arch" type="xml">

            <form string="Mileage Trip">

                <sheet>
                    <field name="expense_id" invisible="1"/>
                    <field name="employee_id" invisible="1"/>
                    <field name="available_vehicle_ids" invisible="1"/>
                    <group>
                        <field name="vehicle_id"/>
                        <field name="trip_type" widget="radio" options="{'horizontal': true}"/>
                    </group>
                    <group string="Departure">
                        <field name="origin_type" widget="radio" options="{'horizontal': true}"/>
                        <field name="origin_street"
                            string="Departure address"
                            widget="google_address_autocomplete"
                            placeholder="Departure address"
                            readonly="origin_type != 'other'"/>
                    </group>
                    <group string="Arrival">
                        <field name="destination_type" widget="radio" options="{'horizontal': true}"/>
                        <field name="destination_street"
                            string="Arrival address"
                            widget="google_address_autocomplete"
                            placeholder="Arrival address"
                            readonly="destination_type != 'other'"/>
                    </group>
                    <group string="Distance" invisible="not distance">
                        <field name="distance"/>
                        <field name="google_origin_address"/>
                        <field name="google_destination_address"/>
                    </group>
                </sheet>

                <footer>
                    <button
                        name="action_compute_distance"
                        type="object"
                        string="Compute Distance"
                        class="btn-secondary"/>

                    <button
                        name="action_apply"
                        type="object"
                        string="Apply"
                        class="btn-primary"/>

                    <button
                        string="Cancel"
                        special="cancel"/>

                </footer>
            </form>
        </field>
    </record>

</odoo>