<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_company_form_preferred_users" model="ir.ui.view">
        <field name="name">res.company.form.preferred.users</field>
        <field name="model">res.company</field>
        <field name="inherit_id" ref="base.view_company_form"/>
        <field name="arch" type="xml">
            <field name="parent_id" position="after">
                <field name="preferred_user_ids" widget="many2many_tags" options="{'no_create': True}"/>
            </field>
        </field>
    </record>
</odoo>
