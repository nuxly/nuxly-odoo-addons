<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- Add mail template to customise the message chatter -->
        <!-- This template add link to the survey and responses that generat contact -->
        <template id="z_message_survey_creat_edit">
            <p>
                <t t-if="edit">This <t t-esc="self.env['ir.model']._get(self._name).name.lower()"/> has been modified from:</t>
                <t t-else="">This <t t-esc="self.env['ir.model']._get(self._name).name.lower()"/> has been created from:</t>
                <t t-foreach="origin1" t-as="o">
                    <a href="#" t-att-data-oe-model="o._name" t-att-data-oe-id="o.id"><t t-esc="o.display_name"/></a><span t-if="origin1[-1] != o">, </span>
                </t>
                <br/>
                Link to the responses:
                <t t-foreach="origin2" t-as="o">
                    <a href="#" t-att-data-oe-model="o._name" t-att-data-oe-id="o.id">Here</a><span t-if="origin2[-1] != o">, </span>
                </t>
            </p>
        </template>
    </data>
</odoo>
