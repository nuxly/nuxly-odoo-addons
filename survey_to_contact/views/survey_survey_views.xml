<odoo>


    <record id="z_view_survey_form" model="ir.ui.view">
        <field name="name">z.survey.form</field>
        <field name="model">survey.survey</field>
        <field name="inherit_id" ref="survey.survey_survey_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='options']/group[@name='options']/group[@name='questions']/field[@name='users_can_go_back']" position="after">
                <!-- Add boolean fields to filter create contact from survey -->
                <field name="z_show_create_partner_button"/>
            </xpath>
            <xpath expr="//notebook/page[@name='questions']/field[@name='question_and_page_ids']/tree/field[@name='title']" position="after">
                <!-- Show res_partner related field to each survey question -->
                <field name="res_partner_field"/>
            </xpath>
        </field>
    </record>

</odoo>