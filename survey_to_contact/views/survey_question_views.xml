<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <!-- Add res_partner related field to each survey question for configuration-->
    <record id="z_survey_question_form" model="ir.ui.view">
        <field name="model">survey.question</field>
        <field name="inherit_id" ref="survey.survey_question_form" />
        <field name="arch" type="xml">
            <xpath expr="//field[@name='comments_allowed']/.." position="after">
                <group name="contact" string="Contact">
                    <field name="res_partner_field"
                               domain="[('model', '=', 'res.partner')]"/>
                    <field name="override_on_merge"/>
                    <field name="sub_contact_group"/>
                </group>
            </xpath>
        </field>
    </record>
</odoo>
