<odoo>

    <!-- Customise user input view o survey to add button create partner from survey -->
    <record id="z_view_survey_form_nuxly" model="ir.ui.view">
        <field name="name">z.survey.form</field>
        <field name="model">survey.user_input</field>
        <field name="inherit_id" ref="survey.survey_user_input_view_form"/>
        <field name="arch" type="xml">
            <field name="test_entry" position="after">
                <field name="z_it_can_be_partner" invisible="1"/>
            </field>
            <xpath expr="//header" position="inside">
                <button name="action_create_partner" type="object" string="Create or merge partner" class="oe_highlight" attrs="{'invisible': [('z_it_can_be_partner', '=', False)]}"/>
            </xpath>
        </field>
    </record>

</odoo>
